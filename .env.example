# ==============================================================================
# Telegram Bot Configuration
# ==============================================================================
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ==============================================================================
# Execution Broker Configuration (MetaTrader 5 Live - Exclusive)
# ==============================================================================
BROKER_MODE=mt5_live
BOT_BROKER_MODE=mt5_live
MT5_ENABLED=true
MT5_MODE=live

# ==============================================================================
# MetaTrader 5 (MT5) Account Credentials
# ==============================================================================
# Your MT5 Live or Demo account login number
MT5_LOGIN=
# Your MT5 account trading password
MT5_PASSWORD=
# Your broker trade server name (e.g. MetaQuotes-Demo, Exness-Real, IC-Markets-Live)
MT5_SERVER=MetaQuotes-Demo
# Optional: MT5 Magic number for identifying orders placed by this bot
MT5_MAGIC=112233
# Optional: Windows terminal64.exe path (auto-detected on Windows; not needed on Linux/Cloud)
MT5_PATH=
# Optional: Remote Windows MT5 Gateway URL if running mt5_gateway_server.py on Windows PC
# Leave blank for native Cloud MT5 Live execution engine on Linux / PocketDev
MT5_GATEWAY_URL=

# ==============================================================================
# Portfolio & Risk Configuration
# ==============================================================================
BOT_EQUITY=10000.0
BOT_LEVERAGE=20.0
BOT_RISK=0.20
BOT_MAX_OPEN_TRADES=5

# ==============================================================================
# Autotrade Settings (Active Multi-Symbol Trading)
# ==============================================================================
BOT_AUTOTRADE=true
BOT_AUTOTRADE_SYMBOLS=XAUUSD,BTCUSDT
BOT_SYMBOL=XAUUSD
BOT_DATA_SOURCE=ccxt
BOT_EXCHANGE=binance
BOT_POLL=10
BOT_FAST_POLL=3

# ==============================================================================
# Strategy & Scalping Profile
# ==============================================================================
BOT_PROFILE=scalp
BOT_SCALP=true
BOT_SCALP_TP_USD=2.5
BOT_SCALP_TP_PCT=0.10
BOT_SCALP_SL_USD=3.0
BOT_SCALP_SL_PCT=0.12

# ==============================================================================
# AI / News & Confluence
# ==============================================================================
BOT_NEWS=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
