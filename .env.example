# ==========================================
# TRADING BOT ENVIRONMENT CONFIGURATION
# ==========================================

# GitHub Personal Access Token (for automatic git push)
GITHUB_TOKEN=your_github_personal_access_token_here

# Telegram Bot Token (from @BotFather on Telegram)
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID (optional, for outbound alerts)
TELEGRAM_CHAT_ID=your_chat_id_here

# Google Gemini API Key (from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Default Trading Symbol (e.g. XAUTUSD, BTCUSD, ETHUSD, EURUSD)
BOT_SYMBOL=XAUTUSD

# Market Data Source: tradingview | demo | ccxt | yfinance | delta
BOT_DATA_SOURCE=tradingview

# CCXT Exchange (if BOT_DATA_SOURCE=ccxt): binance | bybit | etc.
BOT_EXCHANGE=binance

# Trading & Leverage Parameters
BOT_EQUITY=10000.0
BOT_RISK=0.18
BOT_LEVERAGE=100
BOT_AUTOTRADE=true
BOT_POLL=30

# News Agent Filter (ForexFactory calendar & crypto sentiment)
BOT_NEWS=true
BOT_NEWS_WINDOW=30

# Optional Exchange Keys (for live trading execution via CCXT)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
