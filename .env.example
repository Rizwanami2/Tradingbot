TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Exclusive live MT5 execution
BOT_BROKER_MODE=mt5_live
BOT_EQUITY=10000
BOT_LEVERAGE=20
BOT_AUTOTRADE=true
BOT_AUTOTRADE_SYMBOLS=BTCUSDT,XAUUSD
BOT_SYMBOL=XAUUSD
BOT_DATA_SOURCE=ccxt
BOT_MAX_OPEN_TRADES=6
BOT_PROFILE=scalp
BOT_SCALP=true
BOT_SCALP_TP_USD=2.5
BOT_SCALP_TP_PCT=0.10
BOT_SCALP_SL_USD=3.0
BOT_SCALP_SL_PCT=0.12
BOT_NEWS=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# MetaTrader 5 Live (required)
MT5_ENABLED=true
MT5_MODE=live
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
MT5_MAGIC=112233
MT5_GATEWAY_URL=
MT5_BALANCE=10000

# MT5 Driver Backend: ea_bridge (recommended / no native DLL needed), native, gateway, or auto
MT5_BACKEND=ea_bridge
EA_BRIDGE_DIR=

# Live recovery: 0 = clear sticky halt after restart (recommended)
LIVE_PERSIST_HALT=0

# --- AI Advanced Suite ---
AI_ADVANCED_ENABLED=true
AI_SCORECARD_BALANCE_ONLY=true
AI_MIN_SCORECARD=55
AI_MAX_DAILY_TRADES=12
AI_MAX_CONSEC_LOSSES=4
AI_DAILY_LOSS_R_LIMIT=3.0
AI_LOT_CEILING=1.0
AI_HEALTH_LIVE=true
AI_LEARN_FREEZE=false
AI_REVENGE_WINDOW_SEC=900
AI_STALE_SIGNAL_SEC=180
AI_FOMO_ATR_MULT=1.5
AI_REQUIRE_JSON_SCHEMA=true
# Optional: AI_MODE=balance  (enables scorecard even if profile is scalp)
